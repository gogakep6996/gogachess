# =====================================================================
# gogachess — пример переменных окружения.
# Скопируйте в .env (для локалки) или в .env.production (на сервере).
# =====================================================================

# ---------- База данных (PostgreSQL) ----------
# Локально: поднимите Postgres или используйте сервис (Neon / Supabase и т.д.).
DATABASE_URL="postgresql://gogachess:gogachess@localhost:5432/gogachess?schema=public"

# ---------- Безопасность ----------
# Случайная длинная строка (например, openssl rand -hex 32)
JWT_SECRET="change-me-to-a-long-random-string"
# Ключ для Server Actions Next.js (32 байта base64, `openssl rand -base64 32`).
# Без него после каждой пересборки клиенты со старым кешем падают с "Failed to find Server Action".
SERVER_ACTIONS_ENCRYPTION_KEY=""

# ---------- HTTP ----------
PORT=3000
# Полный публичный URL сайта (нужен для cookie/CORS/serverActions allowedOrigins
# И для ссылок в письмах подтверждения email / сброса пароля).
# В продакшене: https://gogachess.ru   В локалке оставьте пустым.
SITE_URL=""

# ---------- Почта (для подтверждения email и сброса пароля) ----------
# Приоритет провайдеров: SMTP → Resend → лог. Достаточно настроить ОДИН.
#
# EMAIL_FROM нужен в любом случае — адрес отправителя на вашем домене.
# Например: "GogaChess <noreply@gogachess.ru>"
EMAIL_FROM=""
#
# --- Вариант A (рекомендуется для РФ): SMTP ---
# Подходит Яндекс 360, Unisender, Sendsay, Mail.ru для бизнеса и т.п.
# Оплата в рублях, нет санкционных рисков, хорошая доставляемость в .ru.
# Пример для Яндекс 360:
#   SMTP_HOST=smtp.yandex.ru
#   SMTP_PORT=465        (465 = SSL; 587 = STARTTLS)
#   SMTP_USER=noreply@gogachess.ru
#   SMTP_PASS=пароль_приложения_из_Яндекса
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Необязательно: true/false. По умолчанию true для порта 465, иначе false.
SMTP_SECURE=""
#
# --- Вариант B: Resend (resend.com), HTTP API ---
# Домен должен быть верифицирован в Resend (DKIM + SPF в DNS).
# Внимание: платные тарифы — иностранная карта (риск для РФ).
RESEND_API_KEY=""

# ---------- Админка ----------
# Email'ы администраторов через запятую — кому доступна страница /admin/users
# со списком всех зарегистрированных аккаунтов. Должны совпадать с email аккаунта,
# под которым вы залогинены. Пусто = страница недоступна (404).
ADMIN_EMAILS=""

# ---------- Капча (Yandex SmartCaptcha) ----------
# Защита формы регистрации от ботов. Без этих переменных капча не показывается,
# и регистрация открыта для автоматических скриптов — на проде заполнить обязательно.
# Создать капчу: https://console.yandex.cloud → SmartCaptcha → Создать капчу.
# 1) Ключ сервера — проверяет токен на бэкенде. Секрет, в репозиторий не попадает.
SMARTCAPTCHA_SERVER_KEY=""
# 2) Ключ клиентской части — рендерит виджет на странице регистрации, он публичный.
NEXT_PUBLIC_SMARTCAPTCHA_CLIENT_KEY=""

# ---------- WebRTC ICE ----------
# Fallback ICE-сервера, если основной канал (Socket.IO 'audio:get-ice-servers') не сработает.
# Можно оставить только STUN — в большинстве сетей этого хватает.
NEXT_PUBLIC_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'

# ---------- Собственный TURN (coturn) ----------
# Обязательно, если вам нужно, чтобы аудио работало через мобильный интернет
# (4G/5G, Carrier-Grade NAT) и за корпоративными файрволлами.
#
# 1) TURN_SECRET — общий секрет coturn ↔ app-сервер.
#    Сервер приложения вычисляет HMAC-SHA1 от этого секрета и выдаёт клиенту
#    короткоживущие credentials (1 час). Coturn проверяет их этим же секретом.
#    Сгенерируйте длинной случайной строкой: `openssl rand -hex 32`.
TURN_SECRET=""
#
# 2) TURN_REALM — доменное имя (для отображения и совпадения с TLS-сертификатом).
#    На VPS это домен сайта, например gogachess.ru.
TURN_REALM="gogachess.ru"
#
# 3) TURN_EXTERNAL_IP — публичный IPv4 вашего VPS.
#    Узнать: `curl -s ifconfig.me` или в панели хостинга.
TURN_EXTERNAL_IP=""
#
# 4) TURN_HOST — как клиент должен обращаться к TURN. Обычно совпадает с TURN_REALM.
#    Должен резолвиться в TURN_EXTERNAL_IP.
TURN_HOST="gogachess.ru"
