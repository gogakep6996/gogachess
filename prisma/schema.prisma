generator client {
  provider = "prisma-client-js"
}

// ПРОД работает в Docker на PostgreSQL (DATABASE_URL задаётся в docker-compose.yml
// как postgresql://...@db:5432/...). Поэтому для коммита/деплоя провайдер ДОЛЖЕН
// быть "postgresql".
// Для локальной разработки можно временно поставить provider = "sqlite"
// (DATABASE_URL="file:./dev.db"), но ОБЯЗАТЕЛЬНО вернуть "postgresql" перед
// коммитом и пушем — иначе Docker-сборка/старт упадёт с P1012.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  phone           String?   @unique
  passwordHash    String
  displayName     String
  /// Когда email был подтверждён ссылкой из письма. null = ещё не подтверждён.
  /// Используется для «soft»-блокировок: создавать класс/турнир можно только
  /// после подтверждения, но обычный логин работает и без него.
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  ownedRooms          Room[]                 @relation("RoomOwner")
  messages            Message[]
  tournamentEntries   TournamentPlayer[]
  ownedTournaments    Tournament[]           @relation("TournamentOwner")
  whiteMatches        TournamentMatch[]      @relation("MatchWhite")
  blackMatches        TournamentMatch[]      @relation("MatchBlack")
  ownedClass          Class?                 @relation("ClassOwner")
  taskSessions        TaskSession[]
  taskAttempts        TaskAttempt[]
  authTokens          AuthToken[]
  notifications       Notification[]

  ownedGroups         Group[]                @relation("GroupOwner")
  groupMemberships    GroupMember[]
  groupJoinRequests   GroupJoinRequest[]
  groupMessages       GroupMessage[]
  sentDms             DirectMessage[]        @relation("DmFrom")
  receivedDms         DirectMessage[]        @relation("DmTo")
  friendRequestsSent     Friendship[]        @relation("FriendRequester")
  friendRequestsReceived Friendship[]        @relation("FriendAddressee")
}

/// Уведомление пользователя — показывается в выпадающем меню аккаунта.
/// Создаётся системой (регистрация, подтверждение почты, рассылки).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  /// null = непрочитано.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Одноразовые токены для email-flow (подтверждение почты, сброс пароля).
/// В БД хранится только SHA-256 хэш токена, в письмо уходит «сырой» токен —
/// если БД утечёт, существующие токены нельзя будет использовать.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256(token) в hex. По нему ищем — поэтому unique.
  tokenHash String    @unique
  /// "email-verify" | "password-reset"
  kind      String
  expiresAt DateTime
  /// Когда токен был использован. Не null = расходован, второй раз не сработает.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, kind])
  @@index([expiresAt])
}

model Room {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  isPublic    Boolean   @default(true)
  ownerId     String
  owner       User      @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  fen         String    @default("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1")
  /// "lesson" | "casual" | "tournament" | "class-lobby" | "student-board" | "class-demo"
  kind        String    @default("lesson")
  /// Например "blitz-5+0", "rapid-10+0"; пусто для уроков.
  timeControl String?
  /// Привязка к турниру (если kind = tournament).
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  messages    Message[]
  match       TournamentMatch?
  taskSession TaskSession?
}

model Message {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

model Tournament {
  id          String   @id @default(cuid())
  name        String
  /// "blitz-3+0" / "blitz-5+0" / "rapid-10+0" / "rapid-15+10" / "classical-30+0" / "bullet-1+0"
  timeControl String
  /// Длительность арены в минутах
  durationMin Int
  /// Когда начинается турнир
  startsAt    DateTime
  /// "scheduled" | "running" | "finished"
  status      String   @default("scheduled")
  ownerId     String
  owner       User     @relation("TournamentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// Турнир группы сообщества (null = обычный публичный турнир).
  /// Показывается в разделе «Турниры» на странице группы.
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  players     TournamentPlayer[]
  matches     TournamentMatch[]
  rooms       Room[]

  @@index([groupId, startsAt])
}

model TournamentPlayer {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  score        Float      @default(0)
  played       Int        @default(0)
  /// Свободен и готов к следующей партии
  isAvailable  Boolean    @default(true)
  joinedAt     DateTime   @default(now())

  @@unique([tournamentId, userId])
  @@index([tournamentId, score])
}

model TournamentMatch {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  roomId       String?    @unique
  room         Room?      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  whiteId      String
  white        User       @relation("MatchWhite", fields: [whiteId], references: [id], onDelete: Cascade)
  blackId      String
  black        User       @relation("MatchBlack", fields: [blackId], references: [id], onDelete: Cascade)
  /// "live" | "white" | "black" | "draw"
  status       String     @default("live")
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?

  @@index([tournamentId, status])
}

/// «Класс» учителя — постоянный учебный кабинет.
/// Один класс на учителя (1:1 c User). URL: /class/<slug>.
model Class {
  id          String   @id @default(cuid())
  ownerId     String   @unique
  owner       User     @relation("ClassOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// URL-slug — генерируется из displayName.
  slug        String   @unique
  /// Опциональное «дружелюбное» название (если null — используем displayName).
  name        String?
  /// Если задан — для входа на урок ученик должен ввести этот код.
  accessCode  String?
  /// Виден ли в общем поиске (true) или только по прямой ссылке (false).
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks           Task[]
  homeworkFolders HomeworkFolder[]
  libraryFolders  LibraryFolder[]
}

/// Папка для домашних заданий внутри класса — учитель раскладывает по ним ДЗ,
/// чтобы не держать все задачи в одной куче.
model HomeworkFolder {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  name      String
  /// Порядок папок в списке.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Связи с задачами: одна задача может лежать сразу в нескольких папках.
  taskLinks HomeworkFolderTask[]

  @@index([classId, position])
}

/// Связь «задача ↔ папка ДЗ» (многие-ко-многим). Позволяет положить одну и ту
/// же домашнюю задачу в несколько папок одновременно.
model HomeworkFolderTask {
  folderId  String
  folder    HomeworkFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@id([folderId, taskId])
  @@index([taskId])
}

/// Папка в «Моей библиотеке» — организационная, ТОЛЬКО для наведения порядка в
/// позициях учителя. НЕ пересекается с папками ДЗ (HomeworkFolder): это другой
/// набор папок и другая связь. Ученики её не видят.
model LibraryFolder {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  name      String
  /// Порядок папок в списке.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Связи с задачами: одна задача может лежать сразу в нескольких папках.
  taskLinks LibraryFolderTask[]

  @@index([classId, position])
}

/// Связь «задача ↔ папка библиотеки» (многие-ко-многим).
model LibraryFolderTask {
  folderId  String
  folder    LibraryFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([folderId, taskId])
  @@index([taskId])
}

/// Учебная задача (позиция-заготовка) в библиотеке учителя.
model Task {
  id          String   @id @default(cuid())
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  title       String
  description String?
  fen         String
  /// 'w' / 'b' — чья очередь хода в задаче (= за кого играет ученик).
  sideToPlay  String   @default("w")
  /// 'easy' | 'medium' | 'hard'
  difficulty  String   @default("medium")
  /// Свободный тэг ("эндшпиль", "тактика", "мат в N").
  category    String?
  /// 'mate' | 'win-material' | 'custom' — для авто-детекта решения.
  goal        String   @default("mate")
  /// Сила движка 0..20 (Stockfish skill level).
  engineLevel Int      @default(10)
  /// Опубликована (видна на витрине ученикам) или черновик.
  isPublished Boolean  @default(true)
  /// Домашнее задание: ученики могут решать эту задачу самостоятельно в любое
  /// время (без урока) на главной странице класса.
  isHomework  Boolean  @default(false)
  /// Порядок в списке.
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions    TaskSession[]
  attempts    TaskAttempt[]
  /// Папки ДЗ, в которых лежит задача (может быть несколько).
  folderLinks HomeworkFolderTask[]
  /// Папки «Моей библиотеки» (организационные, отдельные от ДЗ).
  libraryFolderLinks LibraryFolderTask[]

  @@index([classId, position])
}

/// Живая доска ученика по задаче. Уникальна по (taskId, userId, context) —
/// урок и домашнее задание ведут раздельные доски, чтобы прогресс из домашки
/// не «протекал» в урок и наоборот.
model TaskSession {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Контекст доски: 'lesson' (раздача учителем на уроке) | 'homework'
  /// (самостоятельное решение на странице класса). Разделяет прогресс.
  context     String   @default("lesson")
  /// Привязка к Room (kind='student-board') — там и крутится сокет / движок / история.
  roomId      String?  @unique
  room        Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  /// 'active' | 'solved' | 'abandoned'
  status      String   @default("active")
  /// Snapshot текущей позиции (для быстрой загрузки списка).
  fen         String
  /// Сколько ходов сделано.
  movesPlayed Int      @default(0)
  startedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  solvedAt    DateTime?

  @@unique([taskId, userId, context])
  @@index([taskId, status])
}

/// Лог попытки решения ДОМАШНЕГО задания — по одной записи на каждый запуск
/// «Решать». В отличие от TaskSession (одна живая доска на пару задача+ученик),
/// здесь копится история: сколько попыток было и сколько из них решены.
model TaskAttempt {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'active' | 'solved' | 'abandoned'
  status      String    @default("active")
  /// Сколько ходов сделано к моменту решения/отказа.
  movesPlayed Int       @default(0)
  /// Стартовая позиция попытки (FEN задачи на момент запуска) — нужна для
  /// воспроизведения «до первого хода».
  startFen    String?
  /// Полная история ходов попытки: JSON-массив MoveHistoryEntry (san/from/to/fen).
  /// Учитель по ней перелистывает партию попытки.
  moves       String?
  startedAt   DateTime  @default(now())
  solvedAt    DateTime?

  @@index([taskId, userId])
  @@index([taskId, status])
  @@index([userId])
}

// ============================== СООБЩЕСТВО ==============================

/// Группа сообщества (например «Школа №29»). Создатель = админ.
/// Ученики вступают по инвайт-ссылке или подают заявку из общего списка.
model Group {
  id          String   @id @default(cuid())
  name        String
  country     String
  city        String
  /// Описание внутри группы — редактирует админ.
  description String?
  ownerId     String
  owner       User     @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// Секрет инвайт-ссылки: /community/join/<inviteCode> — вступление без заявки.
  inviteCode  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     GroupMember[]
  requests    GroupJoinRequest[]
  chat        GroupMessage[]
  tournaments Tournament[]

  @@index([country, city])
  @@index([ownerId])
}

/// Участник группы. Владелец группы тоже имеет запись (role='admin') —
/// так список участников и счётчики считаются одним запросом.
model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'admin' | 'member'
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

/// Заявка на вступление (из общего списка групп). Одна активная на пару
/// группа+пользователь; при повторной подаче старая отклонённая перезаписывается.
model GroupJoinRequest {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'pending' | 'approved' | 'rejected'
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, userId])
  @@index([groupId, status])
}

/// Сообщение в чате группы.
model GroupMessage {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([groupId, createdAt])
}

/// Личное сообщение пользователь → пользователь (раздел «Сообщения» в профиле).
/// Основной сценарий: админ одной группы пишет админу другой (договориться о турнире).
model DirectMessage {
  id        String    @id @default(cuid())
  fromId    String
  from      User      @relation("DmFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User      @relation("DmTo", fields: [toId], references: [id], onDelete: Cascade)
  content   String
  /// null = получатель ещё не читал.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([toId, readAt])
  @@index([fromId, toId, createdAt])
  @@index([toId, fromId, createdAt])
}

/// Дружба/заявка в друзья. requester отправил, addressee принимает или отклоняет.
/// Пара хранится один раз (в любом направлении) — уникальность проверяет код.
model Friendship {
  id          String    @id @default(cuid())
  requesterId String
  requester   User      @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User      @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  /// 'pending' | 'accepted' | 'rejected'
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}
